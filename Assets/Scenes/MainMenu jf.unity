  steps:
  - stepName: 1
    title: BUT DU JEU
    description: 
    description1: "AFFRONTEZ VOTRE RIVAL DANS UNE COURSE EFFR\xC9N\xC9E O\xD9 LUMI\xC8RE
      ET T\xC9N\xC8BRES S'AFFRONTENT !\nMOMENTUM EST UN PARKOUR COMP\xC9TITIF EXPLOSIF
      POUR 2 JOUEURS O\xD9 CHAQUE NOTE DE MUSIQUE RYTHME VOS MOUVEMENTS.\nCOLLECTEZ
      DES ORBES LUMINEUSES POUR SURVIVRE AUX PHASES NOCTURNES, SABOTEZ VOTRE ADVERSAIRE
      AVEC DES PI\xC8GES VICIEUX, ET DOMINEZ LE CLASSEMENT MONDIAL SUR DES CARTES
      FUTURISTES \xC9BLOUISSANTES !"
    illustration: {fileID: 0}
  - stepName: 2
    title: 
    description: "SE D\xC9PLACER"
    description1: 
    illustration: {fileID: 21300000, guid: 45ff5e9753d3c6e428db3819a089d141, type: 3}
  - stepName: 3
    title: 
    description: SAUTER
    description1: 
    illustration: {fileID: 21300000, guid: ad28f119879621741bd0152043288a11, type: 3}
  - stepName: 4
    title: 
    description: GLISSER
    description1: 
    illustration: {fileID: 21300000, guid: dd604c16d652bc34bbdefa4e0d8acda6, type: 3}
  - stepName: 5
    title: 
    description: 'BLOQUER SON ADVERSAIRE

      (UNIQUEMENT LE JOUR)'
    description1: 
    illustration: {fileID: 21300000, guid: 4e0039791dfd01c49b73dd70f89d03db, type: 3}
  - stepName: 6
    title: 
    description: 'ALLUMER SA LAMPE

      (UNIQUEMENT LA NUIT)'
    description1: 
    illustration: {fileID: 21300000, guid: 4e0039791dfd01c49b73dd70f89d03db, type: 3}
